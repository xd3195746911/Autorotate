-- ==========================================
-- SCRIPT COMPATIBLE CON DELTA EXECUTOR
-- ==========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local rootJoint = humanoidRootPart:WaitForChild("RootJoint")

local originalC0 = rootJoint.C0

-- ==========================================
-- AJUSTES (CÁMBIALOS A TU GUSTO)
-- ==========================================
local INCLINACION_GRADOS = 180 -- Grados (180 = boca abajo)
local HUNDIMIENTO_STUDS = 4.5  -- Qué tanto te hundes bajo el piso
local VELOCIDAD_ROTACION = 360 -- Velocidad de giro por segundo
local TECLA_ACTIVAR = Enum.KeyCode.E -- Tecla para encender/apagar en PC
-- ==========================================

local estaRobando = false
local conexionRender = nil
local anguloActualY = 0

local function aplicarTransformacion(deltaTime)
	anguloActualY = (anguloActualY + math.rad(VELOCIDAD_ROTACION * deltaTime)) % (math.pi * 2)
	local anguloInclinacion = math.rad(INCLINACION_GRADOS)
	
	local offsetPosicion = Vector3.new(0, -HUNDIMIENTO_STUDS, 0)
	local offsetRotacion = CFrame.Angles(0, anguloActualY, 0) * CFrame.Angles(0, 0, anguloInclinacion)
	
	rootJoint.C0 = originalC0 * CFrame.new(offsetPosicion) * offsetRotacion
end

local function toggleRobo()
	estaRobando = not estaRobando
	
	if estaRobando then
		-- Iniciar giro y hundimiento
		conexionRender = RunService.RenderStepped:Connect(function(deltaTime)
			aplicarTransformacion(deltaTime)
		end)
		print("Modo invisible/hundido: ACTIVADO")
	else
		-- Apagar y volver a la normalidad
		if conexionRender then
			conexionRender:Disconnect()
			conexionRender = nil
		end
		rootJoint.C0 = originalC0
		anguloActualY = 0
		print("Modo invisible/hundido: DESACTIVADO")
	end
end

-- ==========================================
-- ACTIVACIÓN POR TECLA (Para teclado/celular)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- Presiona E para activar o desactivar cuando estés frente al Brainrot
	if input.KeyCode == TECLA_ACTIVAR then
		toggleRobo()
	end
	
	-- Ajustar hundimiento en vivo
	if input.KeyCode == Enum.KeyCode.Down then
		HUNDIMIENTO_STUDS = HUNDIMIENTO_STUDS + 0.5
	elseif input.KeyCode == Enum.KeyCode.Up then
		HUNDIMIENTO_STUDS = math.max(0, HUNDIMIENTO_STUDS - 0.5)
	end
end)
