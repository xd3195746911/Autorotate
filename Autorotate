-- ==========================================
-- SCRIPT DE ROBO CON INCLINACIÓN Y HUNDIMIENTO
-- Colocar en un LocalScript dentro de StarterPlayerScripts
-- ==========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local rootJoint = humanoidRootPart:WaitForChild("RootJoint")

local originalC0 = rootJoint.C0

-- ==========================================
-- CONFIGURACIÓN DE PARÁMETROS
-- ==========================================
local INCLINACION_GRADOS = 180 -- Grados de inclinación (180 = boca abajo)
local HUNDIMIENTO_STUDS = 3.5  -- Profundidad inicial bajo la tierra
local VELOCIDAD_ROTACION = 360 -- Grados por segundo en la rotación continua
local TIEMPO_DURACION = 5      -- Duración del efecto en segundos (Ajustable)
-- ==========================================

local estaRobando = false
local conexionRender = nil
local anguloActualY = 0

-- Función para aplicar las transformaciones frame a frame
local function aplicarTransformacion(deltaTime)
	anguloActualY = (anguloActualY + math.rad(VELOCIDAD_ROTACION * deltaTime)) % (math.pi * 2)
	local anguloInclinacion = math.rad(INCLINACION_GRADOS)
	
	local offsetPosicion = Vector3.new(0, -HUNDIMIENTO_STUDS, 0)
	local offsetRotacion = CFrame.Angles(0, anguloActualY, 0) * CFrame.Angles(0, 0, anguloInclinacion)
	
	rootJoint.C0 = originalC0 * CFrame.new(offsetPosicion) * offsetRotacion
end

-- Función para ocultar el objeto robado bajo la tierra
local function ocultarBrainRot(objeto)
	if not objeto then return end
	if objeto:IsA("Model") and objeto.PrimaryPart then
		objeto:SetPrimaryPartCFrame(objeto.PrimaryPart.CFrame * CFrame.new(0, -50, 0))
	elseif objeto:IsA("BasePart") then
		objeto.CFrame = objeto.CFrame * CFrame.new(0, -50, 0)
	end
	for _, part in ipairs(objeto:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.Transparency = 1
		end
	end
end

-- Iniciar el efecto de robo
local function iniciarRobo(objetoBrainRot)
	if estaRobando then return end
	estaRobando = true
	
	ocultarBrainRot(objetoBrainRot)
	
	conexionRender = RunService.RenderStepped:Connect(function(deltaTime)
		aplicarTransformacion(deltaTime)
	end)
	
	-- Control del tiempo que permanece en esa posición
	task.wait(TIEMPO_DURACION)
	
	detenerRobo()
end

-- Detener el efecto y restaurar al personaje
function detenerRobo()
	if not estaRobando then return end
	estaRobando = false
	
	if conexionRender then
		conexionRender:Disconnect()
		conexionRender = nil
	end
	
	rootJoint.C0 = originalC0
	anguloActualY = 0
end

-- ==========================================
-- CONTROLES EN VIVO (Flechas del teclado)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- Presiona Flecha Abajo para hundirte más
	if input.KeyCode == Enum.KeyCode.Down then
		HUNDIMIENTO_STUDS = HUNDIMIENTO_STUDS + 0.5
		print("Hundimiento actual:", HUNDIMIENTO_STUDS)
		
	-- Presiona Flecha Arriba para salir más a la superficie
	elseif input.KeyCode == Enum.KeyCode.Up then
		HUNDIMIENTO_STUDS = math.max(0, HUNDIMIENTO_STUDS - 0.5)
		print("Hundimiento actual:", HUNDIMIENTO_STUDS)
	end
end)

-- ==========================================
-- EJEMPLO DE ACTIVACIÓN CON PROXIMITYPROMPT
-- ==========================================
local prompt = workspace:FindFirstChild("PromptRobar", true)

if prompt then
	prompt.Triggered:Connect(function()
		iniciarRobo(prompt.Parent)
	end)
end
